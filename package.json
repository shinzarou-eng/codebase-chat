{
  "name": "dsh-codebase-chat",
  "version": "0.25.0",
  "description": "Multi-language codebase intelligence for DeepSeek Harness and MCP-compatible IDEs: chat, search, audit, refactor, and board-ready reports from local code.",
  "homepage": "https://shinzarou-eng.github.io/dsh-codebase-chat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinzarou-eng/dsh-codebase-chat.git"
  },
  "bugs": {
    "url": "https://github.com/shinzarou-eng/dsh-codebase-chat/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dsh-codebase-chat": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@babel/parser": "^8.0.5",
    "@babel/traverse": "^8.0.5",
    "@babel/types": "^8.0.5",
    "@xenova/transformers": "^2.17.2",
    "figlet": "^1.11.4",
    "gpt-tokenizer": "^4.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.20.0"
  },
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "codebase",
    "codebase-intelligence",
    "chat",
    "code-search",
    "refactor",
    "audit",
    "mcp",
    "model-context-protocol",
    "windsurf",
    "cursor",
    "claude",
    "local-ai",
    "rag"
  ],
  "author": "shinzarou-eng",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsup": "^8.5.1",
    "typescript": "5.7.3",
    "vitest": "^5.0.0"
  }
}
