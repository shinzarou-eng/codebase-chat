# codebase-chat — environment variables (all optional)

# --- Direct-LLM mode (only needed if the MCP server should call an API itself) ---
# Without any key, everything runs prompt-only (host model answers) or --no-llm.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Custom OpenAI-compatible endpoint (Ollama, LM Studio, Azure, proxies…)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_BASE_URL=

# Model used for direct-LLM calls
CODEBASE_MODEL=deepseek-chat

# --- Behaviour ---
# Default response language: fr | en
CODEBASE_LANG=fr

# Where the index cache lives (default: OS cache dir)
CODEBASE_CACHE_DIR=

# --- DeepSeek Harness plugin (lib/index.js) ---
# Extra project aliases: DSH_PROJECT_ALIASES="work=C:\\repo;side=D:\\proj"
DSH_PROJECT_ALIASES=

# Extra paths that can never be patched (extends the built-in list)
DSH_PROTECTED_PATHS=
